{
  "version": "1.0",
  "runtime": "nodejs18",
  "build": {
    "commands": {
      "pre-build": [
        "npm ci",
        "npx prisma generate"
      ],
      "build": [
        "npm run build"
      ]
    }
  },
  "run": {
    "runtime-version": "18",
    "command": "npx prisma migrate deploy && node dist/main.js",
    "network": {
      "port": "3000"
    },
    "env": [
      {
        "name": "NODE_ENV",
        "value": "production"
      },
      {
        "name": "PORT",
        "value": "3000"
      }
    ]
  }
}
