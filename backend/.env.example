# Environment
NODE_ENV=development
PORT=3000

# Database — use split vars if password contains @ # % etc. (recommended for Hostinger)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=finpilot
# Or a single URL (encode special chars in password: @ → %40)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finpilot"

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (exact frontend URL, no trailing slash; comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173
# Production example:
# CORS_ORIGIN=https://finpilot.accrescentgroup.com

# Logging
LOG_LEVEL=debug
